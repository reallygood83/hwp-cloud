rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/templates/{templateId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.size is int
        && request.resource.data.size <= 20 * 1024 * 1024
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount <= 40;

      match /chunks/{chunkId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && request.resource.data.data is bytes;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
